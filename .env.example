# Innova (SQL Server) — obligatorio
DB_SERVER=192.168.x.x
DB_NAME=Innova
DB_USER=
DB_PASSWORD=

# Business Central (Azure SQL) — formato recomendado
BC_SERVER=tu-servidor.database.windows.net
BC_DATABASE=tu-base
BC_USER=
BC_PASSWORD=

# Opcional: timeouts BC (segundos)
# BC_TIMEOUT=600
# BC_LOGIN_TIMEOUT=60

# Alternativa BC (formato informal, tambien admitido):
# Server Name: tu-servidor.database.windows.net
# Database: tu-base
# User: tu-usuario
# Password: tu-password

# Innova (SQL Server) — obligatorio
DB_SERVER=192.168.x.x
DB_NAME=Innova
DB_USER=
DB_PASSWORD=

# Fuente BC: api (recomendado: OAuth + API AL/OData + enrich Innova) | sql (Azure SQL replica)
BC_SOURCE=api

# --- BC via API (OAuth App Registration) ---
CLIENT_ID=
TENANT_ID=
CLIENT_SECRET=
BC_ENVIRONMENT=Produccion
COMPANY_ID=
COMPANY_NAME=Stolt Sea Farm, S.A.
# Destino correcto: API AL custom (ver docs/BC_API_AL_CONTRACT.md)
BC_API_PUBLISHER=stolt
BC_API_GROUP=biomasa
BC_API_VERSION=v1.0
BC_API_ENTITY=itemLedgerEntries
# Si la custom no existe, el cliente usa ODataV4 ItemLedgerEntries automaticamente
BC_API_PREFER_CUSTOM=1

# --- BC via Azure SQL (BC_SOURCE=sql, o Conversion productos opcional con api) ---
BC_SERVER=tu-servidor.database.windows.net
BC_DATABASE=tu-base
BC_USER=
BC_PASSWORD=

# Opcional: timeouts BC SQL (segundos)
# BC_TIMEOUT=600
# BC_LOGIN_TIMEOUT=60

# Alternativa BC SQL (formato informal, tambien admitido):
# Server Name: tu-servidor.database.windows.net
# Database: tu-base
# User: tu-usuario
# Password: tu-password
